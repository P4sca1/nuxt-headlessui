{
	"name": "nuxt-headlessui",
	"description": "Headless UI integration for Nuxt",
	"version": "1.2.2",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/P4sca1/nuxt-headlessui.git"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/types.d.mts",
			"import": "./dist/module.mjs"
		}
	},
	"main": "./dist/module.mjs",
	"typesVersions": {
		"*": {
			".": [
				"./dist/types.d.mts"
			]
		}
	},
	"files": [
		"dist"
	],
	"release": {
		"branches": [
			"main",
			{
				"name": "next",
				"prerelease": true
			}
		],
		"preset": "angular",
		"plugins": [
			"@semantic-release/commit-analyzer",
			"@semantic-release/release-notes-generator",
			"@semantic-release/changelog",
			"@semantic-release/npm",
			"@semantic-release/github",
			"@semantic-release/git"
		]
	},
	"scripts": {
		"prepack": "nuxt-module-build build",
		"dev": "pnpm run dev:prepare && nuxi dev playground",
		"dev:build": "nuxi build playground",
		"dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
		"lint": "eslint ."
	},
	"dependencies": {
		"@headlessui/vue": "^1.7.18",
		"@nuxt/kit": "^4.2.1",
		"pathe": "^2.0.3"
	},
	"devDependencies": {
		"@heroicons/vue": "2.2.0",
		"@nuxt/eslint-config": "1.10.0",
		"@nuxt/module-builder": "1.0.2",
		"@nuxt/schema": "4.2.1",
		"@nuxtjs/tailwindcss": "6.14.0",
		"@semantic-release/changelog": "6.0.3",
		"@semantic-release/git": "10.0.1",
		"@types/node": "24.10.1",
		"eslint": "9.39.1",
		"nuxt": "4.2.1",
		"semantic-release": "25.0.2"
	},
	"packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
	"pnpm": {
		"onlyBuiltDependencies": [
			"@parcel/watcher",
			"esbuild",
			"unrs-resolver"
		]
	}
}
